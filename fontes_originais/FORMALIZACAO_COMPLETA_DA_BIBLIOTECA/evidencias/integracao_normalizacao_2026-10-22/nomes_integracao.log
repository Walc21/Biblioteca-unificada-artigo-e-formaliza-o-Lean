  q.Rext x =
    (q.a q.i0).line ↑(q.t 0) + ↑(q.sl q.i0) * (x - ↑(q.t 0)) +
      ∑ j with 1 ≤ ↑j, ↑(q.wt j) * Montagens.relu (x - ↑(q.t j.castSucc))
Montagens.NormChain.Rext_of_M_eq_one {α β : ℝ} {Λ : Finset Montagens.Atom} (q : Montagens.NormChain α β Λ)
  (hM1 : q.M = 1) : q.Rext = (q.a q.i0).line
Montagens.NormChain.Rext_sum {α β : ℝ} {Λ : Finset Montagens.Atom} (q : Montagens.NormChain α β Λ) (x : ℝ) :
  q.Rext x = ↑q.c0 + ↑(q.sl q.i0) * x + ∑ j with 1 ≤ ↑j, ↑(q.wt j) * Montagens.relu (x - ↑(q.t j.castSucc))
Montagens.NormChain.extension {α β : ℝ} {Λ : Finset Montagens.Atom} (q : Montagens.NormChain α β Λ) (hK : α < β)
  {g : Montagens.CK α β} (h : Montagens.LocalRep α β g Λ) :
  Continuous q.Rext ∧
    (∀ (j : Fin q.M) (x : ℝ), ↑(q.t j.castSucc) ≤ x → x ≤ ↑(q.t j.succ) → q.Rext x = (q.a j).line x) ∧
      (∀ (z : ↑(Set.Icc α β)), q.Rext ↑z = g z) ∧
        (∀ x ≤ ↑(q.t 0), q.Rext x = (q.a q.i0).line x) ∧
          (∀ (x : ℝ), ↑(q.t q.iLast.castSucc) ≤ x → q.Rext x = (q.a q.iLast).line x) ∧
            (∀ (j : Fin (q.M + 1)), 1 ≤ ↑j → ↑j < q.M → ↑(q.t j) ∈ Montagens.Kint α β ∩ Montagens.Dy) ∧
              ∀ (hM : 1 < q.M), ∀ x ≤ ↑(q.t ⟨1, ⋯⟩), q.Rext x = (q.a q.i0).line x
Montagens.NormChain.incident {α β : ℝ} {Λ : Finset Montagens.Atom} (q : Montagens.NormChain α β Λ) (j : ℕ)
  (hj : j + 1 < q.M) (h : (q.a ⟨j + 1, hj⟩).line ↑(q.t ⟨j + 1, ⋯⟩) = (q.a ⟨j, ⋯⟩).line ↑(q.t ⟨j + 1, ⋯⟩)) (x : ℝ) :
  (q.a ⟨j + 1, hj⟩).line x - (q.a ⟨j, ⋯⟩).line x = ↑(q.sl ⟨j + 1, hj⟩ - q.sl ⟨j, ⋯⟩) * (x - ↑(q.t ⟨j + 1, ⋯⟩))

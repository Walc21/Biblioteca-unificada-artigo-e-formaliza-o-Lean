      ((∃ c, Dyadic.Lib.PrefixFree c.W) → ⌈Dyadic.Lib.metricEntropy F ε⌉ ≤ ↑(Dyadic.Lib.decLength F ε))
Dyadic.Lib.jointError (K : Set ℝ) (N H : ℕ) (f : ℝ → ℝ) : ENNReal
Dyadic.Lib.jointError_monotone (K : Set ℝ) (f : ℝ → ℝ) (N H : ℕ) :
  Dyadic.Lib.jointError K (N + 1) H f ≤ Dyadic.Lib.jointError K N H f ∧
    Dyadic.Lib.jointError K N (H + 1) f ≤ Dyadic.Lib.jointError K N H f ∧
      (Antitone fun H => Dyadic.Lib.jointError K N H f) ∧
        Filter.Tendsto (fun H => Dyadic.Lib.jointError K N H f) Filter.atTop (nhds (Dyadic.Lib.leafError K N f))
Dyadic.Lib.minHeight (K : Set ℝ) (ε : ℝ) (N : ℕ) (f : ℝ → ℝ) : ℕ
Dyadic.Lib.minimax_lower_bound_asymptotic :
  ∃ c,
    0 < c ∧
      ∃ C H₁,
        2 ≤ H₁ ∧
          ∀ (A : Dyadic.Lib.Atom → ℕ),
            Function.Injective A →
              ∀ H ≥ H₁, ∃ a, a.height ≤ H ∧ c * ↑H ^ 6 - 1 ≤ ↑(A a) ∧ 6 * Real.logb 2 ↑H - C ≤ Real.logb 2 (↑(A a) + 1)
Dyadic.Lib.precision_height (R M : ℝ) :
  (∀ (ε : ℝ),
      0 < ε →
        ∀ f ∈ Dyadic.Lib.FRM R M,
          Dyadic.Lib.jointError (Set.Icc 0 1) (Dyadic.Lib.nEps M ε) (Dyadic.Lib.HEps R M ε) f ≤ ENNReal.ofReal ε ∧
            Dyadic.Lib.minHeight (Set.Icc 0 1) ε (Dyadic.Lib.nEps M ε) f ≤ Dyadic.Lib.HEps R M ε) ∧
    (∃ C, ∀ (ε : ℝ), 0 < ε → ε ≤ 1 → ↑(Dyadic.Lib.nEps M ε) ≤ C / √ε ∧ ↑(Dyadic.Lib.HEps R M ε) ≤ C / ε) ∧
      ∃ C,
        ∀ (ε : ℝ),
          0 < ε →
            ε ≤ 1 →
              ∀ f ∈ Dyadic.Lib.FRM R M,
                ↑(Dyadic.Lib.streamAtom (Dyadic.Lib.leafAtom f (Dyadic.Lib.rEps M ε)) (Dyadic.Lib.nEps M ε)).length ≤
                    C / √ε * Real.logb 2 (2 / ε) ∧
                  ↑(Dyadic.Lib.streamStr (Dyadic.Lib.leafAtom f (Dyadic.Lib.rEps M ε)) (Dyadic.Lib.nEps M ε)).length ≤
                      C / √ε * Real.logb 2 (2 / ε) ∧
                    ↑(Dyadic.Lib.streamRat (Dyadic.Lib.leafAtom f (Dyadic.Lib.rEps M ε)) (Dyadic.Lib.nEps M ε)).length ≤
                      C / √ε * Real.logb 2 (2 / ε)
Dyadic.Lib.relu_mem_Asm (α β : ℝ) (hαβ : α < β) (c q : ℚ) (M : ℕ) (w τ : ℕ → ℚ) (hτ : ∀ j < M, ∃ u e, τ j = ↑u / 2 ^ e)
  (hslope : ∀ x ∈ Set.Icc α β, (∀ j < M, x ≠ ↑(τ j)) → q + ∑ j ∈ Finset.range M with ↑(τ j) < x, w j ≠ 0) :
  Dyadic.Lib.reluNet c q M w τ ∈ Dyadic.Lib.Asm (Set.Icc α β)
Dyadic.Lib.relu_parameters_height {N H : ℕ} (hN : 1 ≤ N) (a : ℕ → Dyadic.Lib.Atom) (ha : ∀ j < N, (a j).height ≤ H) :
  2 + 2 * (N - 1) = 2 * N ∧
    Dyadic.Lib.ratHeight (a 0).intercept ≤ 2 ^ (H + 1) * H ^ 2 ∧
      Dyadic.Lib.ratHeight (a 0).s ≤ 2 ^ (H + 1) * H ^ 2 ∧
        ∀ j ∈ Finset.Ico 1 N,
          Dyadic.Lib.ratHeight (a j).left ≤ 2 ^ (H + 1) * H ^ 2 ∧
            Dyadic.Lib.ratHeight ((a j).s - (a (j - 1)).s) ≤ 2 ^ (H + 1) * H ^ 2
Dyadic.Lib.serialization_gamma :
  (∀ (Λ : Finset Dyadic.Lib.Atom),
      Λ.Nonempty → ∀ (r : List Bool), Dyadic.Lib.deserGamma (Dyadic.Lib.serGamma Λ ++ r) = some (Λ, r)) ∧
    (∃ C H₀, ∀ H ≥ H₀, |↑(Dyadic.Lib.widthGamma H) - 8 * Real.logb 2 ↑H| ≤ C) ∧
      ∃ C,
        ∀ (Λ : Finset Dyadic.Lib.Atom),
          Λ.Nonempty →
            ↑(Dyadic.Lib.serGamma Λ).length ≤
              ↑Λ.card * (8 * Real.logb 2 ↑(Dyadic.Lib.maxHeight Λ) + C) +
                C * (Real.logb 2 ↑Λ.card + Real.logb 2 ↑(Dyadic.Lib.maxHeight Λ))
Dyadic.Lib.serialization_sharp :
  (∀ (K : Set ℝ) (g : ℝ → ℝ) (Λ : Finset Dyadic.Lib.Atom),
      g ∈ Dyadic.Lib.Asm K →
        Dyadic.Lib.IsAssemblyRep K g Λ →
          Λ.Nonempty →
            (∀ (r : List Bool), Dyadic.Lib.deserSharp (Dyadic.Lib.serSharp Λ ++ r) = some (Λ, r)) ∧
              (∀ (g' : ℝ → ℝ), Dyadic.Lib.IsAssemblyRep K g' Λ → ∀ x ∈ K, g' x = g x) ∧
                2 ≤ Dyadic.Lib.maxHeight Λ ∧
                  ↑(Dyadic.Lib.serSharp Λ).length =
                    2 * ↑⌊Real.logb 2 ↑Λ.card⌋₊ + 1 + (2 * ↑⌊Real.logb 2 ↑(Dyadic.Lib.maxHeight Λ)⌋₊ + 1) +
                      ↑Λ.card * ↑⌈Real.logb 2 (18 * ↑(Dyadic.Lib.maxHeight Λ) ^ 6)⌉₊) ∧
    ∃ C,
      ∀ (Λ : Finset Dyadic.Lib.Atom),
        Λ.Nonempty →
          ↑(Dyadic.Lib.serSharp Λ).length ≤
            ↑Λ.card * (6 * Real.logb 2 ↑(Dyadic.Lib.maxHeight Λ) + C) +
              C * (Real.logb 2 ↑Λ.card + Real.logb 2 ↑(Dyadic.Lib.maxHeight Λ))
Dyadic.Lib.simultaneous_control (R M : ℝ) :
  (∀ f ∈ Dyadic.Lib.FRM R M,
      ∀ (r : ℕ),
        1 ≤ r →
          Dyadic.Lib.IsAssemblyRep (Set.Icc 0 1) (Dyadic.Lib.gN f r) (Dyadic.Lib.leavesN f r) ∧
            (Dyadic.Lib.leavesN f r).card = 2 ^ r ∧
              Dyadic.Lib.gN f r ∈ Dyadic.Lib.Asm (Set.Icc 0 1) ∧
                (∀ x ∈ Set.Icc 0 1, |f x - Dyadic.Lib.gN f r x| ≤ (M + 4) / (8 * (2 ^ r) ^ 2)) ∧
                  (∀ a ∈ Dyadic.Lib.leavesN f r, ↑a.height ≤ Dyadic.Lib.CH R M * (2 ^ r) ^ 2) ∧
                    ∀ (j : ℕ),
                      ↑(Dyadic.Lib.vNode f r j) ∈ Dyadic.Lib.altGrid r j ∧
                        ∀ w ∈ Dyadic.Lib.altGrid r j,
                          |↑(Dyadic.Lib.vNode f r j) - f (↑j / 2 ^ r)| ≤ |w - f (↑j / 2 ^ r)| ∧
                            (|↑(Dyadic.Lib.vNode f r j) - f (↑j / 2 ^ r)| = |w - f (↑j / 2 ^ r)| →
                              ↑(Dyadic.Lib.vNode f r j) ≤ w)) ∧
    (∃ C,
        ∀ f ∈ Dyadic.Lib.FRM R M,
          ∀ (r : ℕ),
            1 ≤ r →
              ↑(Dyadic.Lib.streamAtom (Dyadic.Lib.leafAtom f r) (2 ^ r)).length ≤ C * 2 ^ r * Real.logb 2 (2 * 2 ^ r) ∧
                ↑(Dyadic.Lib.streamStr (Dyadic.Lib.leafAtom f r) (2 ^ r)).length ≤ C * 2 ^ r * Real.logb 2 (2 * 2 ^ r) ∧
                  ↑(Dyadic.Lib.streamRat (Dyadic.Lib.leafAtom f r) (2 ^ r)).length ≤
                    C * 2 ^ r * Real.logb 2 (2 * 2 ^ r)) ∧
      ∀ f ∈ Dyadic.Lib.FRM R M,
        ∀ (N : ℕ),
          2 ≤ N →
            Dyadic.Lib.jointError (Set.Icc 0 1) N ⌈Dyadic.Lib.CH R M * ↑N ^ 2⌉₊ f <
              ENNReal.ofReal ((M + 4) / (2 * ↑N ^ 2))
Dyadic.Lib.sqrt_two_inf_not_attained :
  sInf {e | ∃ n, 1 / 4 ∈ (Dyadic.Lib.decode n).cell ∧ e = |√2 - (Dyadic.Lib.decode n).line (1 / 4)|} = 0 ∧
    ∀ (n : ℕ), 1 / 4 ∈ (Dyadic.Lib.decode n).cell → |√2 - (Dyadic.Lib.decode n).line (1 / 4)| ≠ 0
Dyadic.Lib.taylor_jet (k : ℕ) (m : ℤ) (f : ℝ → ℝ) (hf : ContDiffOn ℝ 2 f (Dyadic.Lib.dyCell k m)) :
  (∀ (y₀ s : ℚ),
      s ≠ 0 →
        f (Dyadic.Lib.dyCenter k m) = ↑y₀ →
          derivWithin f (Dyadic.Lib.dyCell k m) (Dyadic.Lib.dyCenter k m) = ↑s →
            ∃ a,
              a.k = k ∧
                a.m = m ∧
                  a.cell = Dyadic.Lib.dyCell k m ∧
                    ∀ (x : ℝ),
                      a.line x =
                        f (Dyadic.Lib.dyCenter k m) +
                          derivWithin f (Dyadic.Lib.dyCell k m) (Dyadic.Lib.dyCenter k m) *
                            (x - Dyadic.Lib.dyCenter k m)) ∧
    ∀ (M : ℝ),
      (∀ x ∈ Dyadic.Lib.dyCell k m, |iteratedDerivWithin 2 f (Dyadic.Lib.dyCell k m) x| ≤ M) →
        ∀ δ > 0,
          ∃ q₀ q₁,
            q₁ ≠ 0 ∧
              (∀ x ∈ Dyadic.Lib.dyCell k m,
                  |f (Dyadic.Lib.dyCenter k m) +
                          derivWithin f (Dyadic.Lib.dyCell k m) (Dyadic.Lib.dyCenter k m) *
                            (x - Dyadic.Lib.dyCenter k m) -
                        (↑q₀ + ↑q₁ * (x - Dyadic.Lib.dyCenter k m))| <
                    δ) ∧
                ∀ x ∈ Dyadic.Lib.dyCell k m,
                  |f x - (↑q₀ + ↑q₁ * (x - Dyadic.Lib.dyCenter k m))| ≤ (1 / 2 ^ k) ^ 2 / 8 * M + δ
Dyadic.Lib.worstAddress_theta :
  (∃ c C,
      0 < c ∧
        0 < C ∧ ∃ H₀, ∀ H ≥ H₀, c * ↑H ^ 8 ≤ ↑(Dyadic.Lib.worstAddress H) ∧ ↑(Dyadic.Lib.worstAddress H) ≤ C * ↑H ^ 8) ∧
    ∃ C H₀, ∀ H ≥ H₀, |Real.logb 2 (↑(Dyadic.Lib.worstAddress H) + 1) - 8 * Real.logb 2 ↑H| ≤ C
Fase3.IsAssembly (α β : ℝ) (g : ℝ → ℝ) : Prop
Fase3.Mint_ge_supNorm (E : Fase3.Expr) (J : Fase3.Iv) (P d : ℕ) (I : Fase3.Iv)
  (h : Fase3.boundSecondDerivative E J P d = some I) (hJ : J.lo ≤ J.hi) :

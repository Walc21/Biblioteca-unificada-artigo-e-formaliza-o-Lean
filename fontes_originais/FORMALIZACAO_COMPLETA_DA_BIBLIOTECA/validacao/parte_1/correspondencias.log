Montagens.sortAtoms_props (F : Finset Montagens.Atom) :
  (Montagens.sortAtoms F).length = F.card ∧
    (Montagens.sortAtoms F).Nodup ∧
      (∀ (a : Montagens.Atom), a ∈ Montagens.sortAtoms F ↔ a ∈ F) ∧
        List.Pairwise (fun x1 x2 => x1 < x2) (Montagens.sortAtoms F)

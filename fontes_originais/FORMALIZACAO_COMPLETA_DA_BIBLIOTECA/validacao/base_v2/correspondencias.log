  (∀ (c : Dyadic.Lib.Codec F ε) (ℓ : ℕ), (∀ w ∈ c.W, w.length = ℓ) → ⌈Dyadic.Lib.metricEntropy F ε⌉ ≤ ↑ℓ) ∧
    (∀ (c : Dyadic.Lib.Codec F ε) (ℓ : ℕ),

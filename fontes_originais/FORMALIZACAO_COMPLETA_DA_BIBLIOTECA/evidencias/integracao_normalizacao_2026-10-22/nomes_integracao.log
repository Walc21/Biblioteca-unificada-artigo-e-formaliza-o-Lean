  (Function.Injective fun p => Fase3.center p.1 p.2) ∧ (Set.range fun p => Fase3.center p.1 p.2) = Fase3.dyadicMid
Fase3.center_error_eq (f : ℝ → ℝ) {xL xR : ℝ} (h : xL ≠ xR) :
  |f ((xL + xR) / 2) - Fase3.linInterp xL xR (f xL) (f xR) ((xL + xR) / 2)| =

Fase3.Qenum_bijective : Function.Bijective Fase3.Qenum
Fase3.QstarEnum_bijective : Function.Bijective Fase3.QstarEnum
Fase3.assembly_dense {α β : ℝ} (hαβ : α < β) {f : ℝ → ℝ} (hf : ContinuousOn f (Set.Icc α β)) {ε : ℝ} (hε : 0 < ε) :
  ∃ g, Fase3.IsAssembly α β g ∧ (Fase3.supNormOn (Set.Icc α β) fun x => f x - g x) < ε
Fase3.boundSecondDerivative_correct (E : Fase3.Expr) (J : Fase3.Iv) (P d : ℕ) (I : Fase3.Iv)
  (h : Fase3.boundSecondDerivative E J P d = some I) (x : ℝ) (hx : J.Mem x) :
  ContDiffAt ℝ 2 E.eval x ∧ deriv (deriv E.eval) x ∈ Set.Icc ↑I.lo ↑I.hi ∧ |deriv (deriv E.eval) x| ≤ ↑(Fase3.Mint I)
Fase3.calibration {M : ℕ × ℤ → ℝ} {J0 : ℕ × ℤ} {κ : ℝ} (f : ℝ → ℝ) (hκ : κ ≠ 0)
  (hM : ∀ (J : ℕ × ℤ), Fase3.cC J ⊆ Fase3.cC J0 → M J = |κ|)
  (hf2 : ∀ x ∈ Set.Icc (Fase3.cL J0) (Fase3.cR J0), Fase3.d2 f (Fase3.cL J0) (Fase3.cR J0) x = κ) :
  (∀ ε > 0,
      (∀ (s : ℕ),
          Fase3.refineAll M ε [J0] (Fase3.rcal (Fase3.mesh J0.1 ^ 2 * |κ| / 8) ε + s) =
            Fase3.refineAll M ε [J0] (Fase3.rcal (Fase3.mesh J0.1 ^ 2 * |κ| / 8) ε)) ∧
        (Fase3.refineAll M ε [J0] (Fase3.rcal (Fase3.mesh J0.1 ^ 2 * |κ| / 8) ε)).length =
          2 ^ Fase3.rcal (Fase3.mesh J0.1 ^ 2 * |κ| / 8) ε) ∧
    Filter.liminf (fun ε => √ε * ↑(Fase3.refineAll M ε [J0] (Fase3.rcal (Fase3.mesh J0.1 ^ 2 * |κ| / 8) ε)).length)
          (nhdsWithin 0 (Set.Ioi 0)) =
        1 / √8 * ∫ (x : ℝ) in Fase3.cL J0..Fase3.cR J0, √|Fase3.d2 f (Fase3.cL J0) (Fase3.cR J0) x| ∧
      Filter.limsup (fun ε => √ε * ↑(Fase3.refineAll M ε [J0] (Fase3.rcal (Fase3.mesh J0.1 ^ 2 * |κ| / 8) ε)).length)
          (nhdsWithin 0 (Set.Ioi 0)) =
        1 / √2 * ∫ (x : ℝ) in Fase3.cL J0..Fase3.cR J0, √|Fase3.d2 f (Fase3.cL J0) (Fase3.cR J0) x|
Fase3.calkinWilf_two_pow (q : ℕ) (hq : 1 ≤ q) : Fase3.calkinWilf (2 ^ (q - 1)) = 1 / ↑q
Fase3.card_QH_ge (H : ℕ) : ↑H ^ 2 / 4 ≤ ↑(Fase3.QH H).card
Fase3.card_QH_le (H : ℕ) (hH : 1 ≤ H) : (Fase3.QH H).card ≤ 3 * H ^ 2
Fase3.cdiag_eq_floor (n : ℕ) : ↑(Fase3.cdiag n) = ⌊(√(8 * ↑n + 1) - 1) / 2⌋
Fase3.cellOwn_partition (k : ℕ) (x : ℝ) : ∃! m, x ∈ Fase3.cellOwn k m
Fase3.cell_length (k : ℕ) (m : ℤ) : Fase3.cellR k m - Fase3.cellL k m = 2 ^ (-↑k)
Fase3.cell_refine (k : ℕ) (m : ℤ) : Fase3.cell k m = Fase3.cell (k + 1) (2 * m) ∪ Fase3.cell (k + 1) (2 * m + 1)
Fase3.center_bijOn :
  (Function.Injective fun p => Fase3.center p.1 p.2) ∧ (Set.range fun p => Fase3.center p.1 p.2) = Fase3.dyadicMid
Fase3.center_error_eq (f : ℝ → ℝ) {xL xR : ℝ} (h : xL ≠ xR) :
  |f ((xL + xR) / 2) - Fase3.linInterp xL xR (f xL) (f xR) ((xL + xR) / 2)| =
    1 / 2 * |f xL - 2 * f ((xL + xR) / 2) + f xR|
Fase3.cpair_bijective : Function.Bijective fun p => Fase3.cpair p.1 p.2
Fase3.cpair_le (u v : ℕ) : Fase3.cpair u v ≤ (u + v + 1) ^ 2
Fase3.cube_example :
  (∀ (x : ℝ), Fase3.linInterp (-1) 1 ((-1) ^ 3) (1 ^ 3) x = x) ∧
    (-1) ^ 3 - 2 * 0 ^ 3 + 1 ^ 3 = 0 ∧ (Fase3.supNormOn (Set.Icc (-1) 1) fun x => x ^ 3 - x) = 2 / (3 * √3)
Fase3.decode4_bijective : Function.Bijective Fase3.decode4
Fase3.dyadicMid_dense : Dense Fase3.dyadicMid
Fase3.errP_le {f : ℝ → ℝ} {α β : ℝ} (hαβ : α < β) (hf : ContDiffOn ℝ 2 f (Set.Icc α β)) (k : ℕ) :
  Fase3.errP f α β k ≤ Fase3.mesh k ^ 2 * Fase3.normD2 f α β / 8
Fase3.exists_assembly_rate {f : ℝ → ℝ} {α β : ℝ} (hαβ : α < β) (hf : ContDiffOn ℝ 2 f (Set.Icc α β)) (k : ℕ) {δ : ℝ}
  (hδ : 0 < δ) :
  ∃ g,
    Fase3.IsAssembly α β g ∧
      (Fase3.supNormOn (Set.Icc α β) fun x => f x - g x) ≤ Fase3.mesh k ^ 2 * Fase3.normD2 f α β / 8 + δ
Fase3.exists_assembly_seq_constant {f : ℝ → ℝ} {α β : ℝ} (hαβ : α < β) (hf : ContDiffOn ℝ 2 f (Set.Icc α β)) :
  ∃ g,
    (∀ (k : ℕ), Fase3.IsAssembly α β (g k)) ∧
      Filter.Tendsto (fun k => 8 / Fase3.mesh k ^ 2 * Fase3.supNormOn (Set.Icc α β) fun x => f x - g k x) Filter.atTop
        (nhds (Fase3.normD2 f α β))
Fase3.exp_sub_expPoly_bounds {z : ℝ} (hz0 : 0 ≤ z) (hz1 : z ≤ 1 / 2) (n : ℕ) :
  0 ≤ Real.exp z - Fase3.expPoly n z ∧
    Real.exp z - Fase3.expPoly n z ≤ z ^ (n + 1) / ↑(n + 1).factorial * (1 / (1 - z / (↑n + 2)))
Fase3.gen (n : ℕ) : ℝ × ℝ × ℝ × ℝ
Fase3.gen_injective : Function.Injective Fase3.gen
Fase3.jet_bijective : Function.Injective Fase3.jet ∧ Set.range Fase3.jet = {p | p.1 ∈ Fase3.dyadicMid ∧ p.2.2 ≠ 0}
Fase3.jet_dense : Dense (Set.range fun n => (Fase3.x0 n, ↑(Fase3.y0 n), ↑(Fase3.slope n)))
Fase3.library : Set (ℝ × ℝ × ℝ × ℝ)
Fase3.preimageInterval_eq (n : ℕ) : Fase3.preimageInterval n = Fase3.cell (Fase3.gK n) (Fase3.gM n)
Fase3.rStar (h0 Mstar εI : ℝ) : ℕ
Fase3.rankQ_lt (r : ℚ) (H : ℕ) (hH : Fase3.ht r ≤ H) : Fase3.rankQ r < 3 * H ^ 2
Fase3.rankQstar_lt (r : { r // r ≠ 0 }) (H : ℕ) (hH : Fase3.ht ↑r ≤ H) : Fase3.rankQstar r < 3 * H ^ 2
Fase3.refineAll (M : ℕ × ℤ → ℝ) (ε : ℝ) (roots : List (ℕ × ℤ)) (r : ℕ) : List (ℕ × ℤ)
Fase3.refineCell (M : ℕ × ℤ → ℝ) (ε : ℝ) : ℕ → ℕ × ℤ → List (ℕ × ℤ)
Fase3.refine_correct {f : ℝ → ℝ} {α β : ℝ} (hαβ : α < β) (hf : ContDiffOn ℝ 2 f (Set.Icc α β)) (M : ℕ × ℤ → ℝ)
  {Mstar εI εR h0 : ℝ}
  (hM : ∀ (J : ℕ × ℤ), (∀ x ∈ Fase3.cC J, |deriv (deriv (Fase3.extF f α β)) x| ≤ M J) ∧ M J ≤ Mstar) (hεI : 0 < εI)
  (hεR : 0 < εR) (roots : List (ℕ × ℤ)) (hroots : List.Pairwise Fase3.DisjInt roots)
  (hcov : Set.Icc α β ⊆ ⋃ J ∈ roots, Fase3.cC J) (hh0 : ∀ J ∈ roots, Fase3.mesh J.1 ≤ h0) :
  (∃ v,
      (∀ J ∈ Fase3.refineAll M εI roots (Fase3.rStar h0 Mstar εI),
          |↑(v (Fase3.cL J)) - Fase3.extF f α β (Fase3.cL J)| < εR ∧
            |↑(v (Fase3.cR J)) - Fase3.extF f α β (Fase3.cR J)| < εR) ∧
        ∀ J ∈ Fase3.refineAll M εI roots (Fase3.rStar h0 Mstar εI), v (Fase3.cL J) ≠ v (Fase3.cR J)) ∧
    ∀ (v : ℝ → ℚ),
      (∀ J ∈ Fase3.refineAll M εI roots (Fase3.rStar h0 Mstar εI),
          |↑(v (Fase3.cL J)) - Fase3.extF f α β (Fase3.cL J)| < εR ∧
            |↑(v (Fase3.cR J)) - Fase3.extF f α β (Fase3.cR J)| < εR) →
        (∀ J ∈ Fase3.refineAll M εI roots (Fase3.rStar h0 Mstar εI), v (Fase3.cL J) ≠ v (Fase3.cR J)) →
          Fase3.IsAssembly α β
              (Fase3.cellInterp (Fase3.refineAll M εI roots (Fase3.rStar h0 Mstar εI)).toFinset fun t => ↑(v t)) ∧
            (∀ J ∈ Fase3.refineAll M εI roots (Fase3.rStar h0 Mstar εI),
                ∃! n,
                  Fase3.gK n = J.1 ∧
                    Fase3.gM n = J.2 ∧ ∀ (x : ℝ), Fase3.atomLine n x = Fase3.lin J (fun t => ↑(v t)) x) ∧
              (Fase3.supNormOn (Set.Icc α β) fun x =>
                  f x -
                    Fase3.cellInterp (Fase3.refineAll M εI roots (Fase3.rStar h0 Mstar εI)).toFinset (fun t => ↑(v t))
                      x) ≤
                εI + εR
Fase3.refine_terminates (M : ℕ × ℤ → ℝ) {Mstar εI h0 : ℝ} (hM : ∀ (J : ℕ × ℤ), M J ≤ Mstar) (hεI : 0 < εI)
  (roots : List (ℕ × ℤ)) (hh0 : ∀ J ∈ roots, Fase3.mesh J.1 ≤ h0) :
  (∀ (s : ℕ),
      Fase3.refineAll M εI roots (Fase3.rStar h0 Mstar εI + s) = Fase3.refineAll M εI roots (Fase3.rStar h0 Mstar εI)) ∧
    (∀ L ∈ Fase3.refineAll M εI roots (Fase3.rStar h0 Mstar εI), Fase3.cert M L ≤ εI) ∧
      (∀ L ∈ Fase3.refineAll M εI roots (Fase3.rStar h0 Mstar εI),
          ∃ J0 ∈ roots, J0.1 ≤ L.1 ∧ L.1 ≤ J0.1 + Fase3.rStar h0 Mstar εI ∧ Fase3.cC L ⊆ Fase3.cC J0) ∧
        (Fase3.refineAll M εI roots (Fase3.rStar h0 Mstar εI)).length ≤ roots.length * 2 ^ Fase3.rStar h0 Mstar εI
Fase3.sin_cos_lagrange (n : ℕ) {a b z : ℝ} (hz : z ∈ Set.Icc a b) :
  |Real.sin z - Fase3.sinPoly n z| ≤ max |a| |b| ^ (2 * n + 2) / ↑(2 * n + 2).factorial ∧
    |Real.cos z - Fase3.cosPoly n z| ≤ max |a| |b| ^ (2 * n + 1) / ↑(2 * n + 1).factorial
Fase3.tendsto_errP {f : ℝ → ℝ} {α β : ℝ} (hαβ : α < β) (hf : ContDiffOn ℝ 2 f (Set.Icc α β)) :
  Filter.Tendsto (fun k => 8 / Fase3.mesh k ^ 2 * Fase3.errP f α β k) Filter.atTop (nhds (Fase3.normD2 f α β))
Fase3.zEnum_bijective : Function.Bijective Fase3.zEnum
Fase3.zInv_le (m : ℤ) : ↑(Fase3.zInv m) ≤ 2 * |m| + 1

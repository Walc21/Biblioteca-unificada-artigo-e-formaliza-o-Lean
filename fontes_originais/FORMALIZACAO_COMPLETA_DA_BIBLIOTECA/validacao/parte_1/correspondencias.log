Montagens.codec (i : Montagens.Phase) :
  (∀ (a : Montagens.Atom), Montagens.dec i (Montagens.enc i a) = a) ∧
    (∀ (n : ℕ), Montagens.enc i (Montagens.dec i n) = n) ∧
      ∀ (n : ℕ) (x : ℝ), Montagens.lam i n x = (Montagens.dec i n).line x
Montagens.dK {α β : ℝ} (f g : Montagens.CK α β) : ℝ
Montagens.dK_isMax {α β : ℝ} (hK : α < β) (f g : Montagens.CK α β) :
  (∃ z₀, Montagens.dK f g = |f z₀ - g z₀| ∧ ∀ (z : ↑(Set.Icc α β)), |f z - g z| ≤ |f z₀ - g z₀|) ∧
    Montagens.dK f g = ‖f - g‖ ∧ 0 ≤ Montagens.dK f g

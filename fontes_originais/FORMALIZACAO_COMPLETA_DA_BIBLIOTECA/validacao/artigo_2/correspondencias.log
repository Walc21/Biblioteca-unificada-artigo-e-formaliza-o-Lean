Artigo.Setup.bit_complexity (S : Artigo.Setup) {B L : ℕ}
  (hdata : ∀ p ∈ S.data, Artigo.bl p.1 ≤ B ∧ Artigo.bl p.2.1 ≤ B ∧ Artigo.bl p.2.2 ≤ B) (hlb : Artigo.bl S.lb ≤ B)
  (hls : Artigo.bl S.ls ≤ B) {k r : ℕ} {m : ℤ} (hd : Artigo.IsDesc S.k₀ S.m₀ k m r) {R : Artigo.LTree}
  (hR : Artigo.LTree.WF k m R) (hdep : r + R.depth ≤ S.D) (hh : R.maxHeight ≤ S.H) (hL : (Artigo.serRec R).length ≤ L) :
  Artigo.bl (S.costT R) ≤
    2 * (S.data.length * (5 * B + 6 * Nat.clog 2 S.H + 2 * (S.k₀ + S.D) + 9) + 2 * B + 2 * Nat.clog 2 L + 2) + 3
Artigo.Setup.bottleneck (S : Artigo.Setup) (hH : 2 ≤ S.H) (f : ℝ → ℝ) (N : ℕ) :
  (Artigo.Etree f S.k₀ S.m₀ N S.H S.D =
      (Finset.Icc 1 (min N (2 ^ S.D)) ×ˢ S.V ×ˢ S.V).inf fun q => S.Bb f S.D q.1 S.k₀ S.m₀ q.2.1 q.2.2) ∧
    (S.H - S.k₀ - 1 ≤ S.D →
      (∀ (a : Artigo.Atom), a.height ≤ S.H → S.k₀ ≤ a.k → a.k - S.k₀ ≤ S.D) ∧
        ∀ (R : Artigo.LTree), Artigo.LTree.WF S.k₀ S.m₀ R → R.maxHeight ≤ S.H → R.depth ≤ S.D)
Artigo.Setup.bottleneck_correctness (S : Artigo.Setup) (hH : 2 ≤ S.H) (f : ℝ → ℝ) (d n k r : ℕ) (m : ℤ) (u v : ℚ) :
  Artigo.IsDesc S.k₀ S.m₀ k m r → r + d ≤ S.D → S.Bb f d n k m u v = (S.RsetN d n k m u v).inf (Artigo.bott f)
Artigo.Setup.fixed_correctness (S : Artigo.Setup) (hH : 2 ≤ S.H) (T : Artigo.Setup.Shape) (k r : ℕ) (m : ℤ) (u v : ℚ) :
  Artigo.IsDesc S.k₀ S.m₀ k m r → r + T.depth ≤ S.D → S.Cfix T k m u v = (S.RsetS T k m u v).inf S.costW
Artigo.Setup.fixed_global (S : Artigo.Setup) (hH : 2 ≤ S.H) (T : Artigo.Setup.Shape) (hT : T.depth ≤ S.D) :
  ((S.V ×ˢ S.V).inf fun p => S.Cfix T S.k₀ S.m₀ p.1 p.2) = (S.RepShape T).inf S.costW ∧
    ((S.RepShape T).Nonempty → ∃! R, R ∈ S.RepShape T ∧ ∀ R' ∈ S.RepShape T, S.kappa R ≤ S.kappa R')
Artigo.Setup.leaf_budget (S : Artigo.Setup) (hH : 2 ≤ S.H) (d n k r : ℕ) (m : ℤ) (u v : ℚ) :
  Artigo.IsDesc S.k₀ S.m₀ k m r → r + d ≤ S.D → S.Cb d n k m u v = (S.RsetN d n k m u v).inf S.costW
Artigo.Setup.leaf_budget_atMost (S : Artigo.Setup) (hH : 2 ≤ S.H) (N : ℕ) :
  ((Finset.Icc 1 (min N (2 ^ S.D)) ×ˢ S.V ×ˢ S.V).inf fun q => S.Cb S.D q.1 S.k₀ S.m₀ q.2.1 q.2.2) =
    {R ∈ Artigo.RepCat S.H S.D S.k₀ S.m₀ | R.numLeaves ≤ N}.inf S.costW
Artigo.Setup.shape_enumeration (S : Artigo.Setup) (hH : 2 ≤ S.H) :
  (S.Cstar = (Artigo.Setup.allShapes S.D).inf fun T => (S.V ×ˢ S.V).inf fun p => S.Cfix T S.k₀ S.m₀ p.1 p.2) ∧
    ∀ R ∈ Artigo.RepCat S.H S.D S.k₀ S.m₀,
      (∀ R' ∈ Artigo.RepCat S.H S.D S.k₀ S.m₀, S.kappa R ≤ S.kappa R') →
        Artigo.Setup.shapeOf R ∈ Artigo.Setup.allShapes S.D ∧
          ∀ R' ∈ S.RepShape (Artigo.Setup.shapeOf R), S.kappa R ≤ S.kappa R'
Artigo.Setup.state_complexity (S : Artigo.Setup) (hH : 2 ≤ S.H) (N : ℕ) :
  (Artigo.cellsD S.D ×ˢ S.V ×ˢ S.V).card = (2 ^ (S.D + 1) - 1) * S.V.card ^ 2 ∧
    (Artigo.internalCells S.D ×ˢ S.V ×ˢ S.V ×ˢ S.V).card ≤ (2 ^ (S.D + 1) - 1) * S.V.card ^ 3 ∧
      (Artigo.cellsD S.D ×ˢ (S.V ×ˢ S.V) ×ˢ Finset.Icc 1 N).card = (2 ^ (S.D + 1) - 1) * N * S.V.card ^ 2 ∧
        (Artigo.internalCells S.D ×ˢ (S.V ×ˢ S.V ×ˢ S.V) ×ˢ Artigo.budgetPairs N).card ≤
            (2 ^ (S.D + 1) - 1) * N ^ 2 * S.V.card ^ 3 ∧
          (Artigo.cellsD S.D ×ˢ (S.V ×ˢ S.V) ×ˢ Finset.range S.data.length).card =
              (2 ^ (S.D + 1) - 1) * S.data.length * S.V.card ^ 2 ∧
            (Artigo.internalCells S.D ×ˢ S.V ×ˢ S.V ×ˢ S.V).card ≤ (2 ^ (S.D + 1) - 1) * (36 ^ 3 * S.H ^ 18)
Artigo.Setup.truncation_convergence (S : Artigo.Setup) :
  (∀ {D D' H : ℕ}, 2 ≤ H → D ≤ D' → S.CstarE D' H ≤ S.CstarE D H) ∧
    (∀ {D H H' : ℕ}, 2 ≤ H → H ≤ H' → S.CstarE D H' ≤ S.CstarE D H) ∧
      ⨅ D, ⨅ H, ⨅ (_ : 2 ≤ H), S.CstarE D H = ⨅ R, ⨅ (_ : Artigo.LTree.WF S.k₀ S.m₀ R), S.costE R ∧
        (∀ (Dj Hj : ℕ → ℕ),
            Monotone Dj →
              Monotone Hj →
                Filter.Tendsto Dj Filter.atTop Filter.atTop →
                  Filter.Tendsto Hj Filter.atTop Filter.atTop →
                    (∀ (j : ℕ), 2 ≤ Hj j) →
                      Filter.Tendsto (fun j => S.CstarE (Dj j) (Hj j)) Filter.atTop
                        (nhds (⨅ R, ⨅ (_ : Artigo.LTree.WF S.k₀ S.m₀ R), S.costE R))) ∧
          ((∃ R₀,
              Artigo.LTree.WF S.k₀ S.m₀ R₀ ∧
                ∀ (R : Artigo.LTree), Artigo.LTree.WF S.k₀ S.m₀ R → S.costT R₀ ≤ S.costT R) →
            ∃ Rs,
              Artigo.LTree.WF S.k₀ S.m₀ Rs ∧
                (∀ (R : Artigo.LTree), Artigo.LTree.WF S.k₀ S.m₀ R → S.costT Rs ≤ S.costT R) ∧
                  (∀ (R : Artigo.LTree),
                      Artigo.LTree.WF S.k₀ S.m₀ R →
                        (∀ (R' : Artigo.LTree), Artigo.LTree.WF S.k₀ S.m₀ R' → S.costT R ≤ S.costT R') →
                          S.kappa Rs ≤ S.kappa R) ∧
                    ∃ D₀ H₀,
                      ∀ (D H : ℕ),
                        D₀ ≤ D →
                          H₀ ≤ H →
                            Rs ∈ Artigo.RepCat H D S.k₀ S.m₀ ∧
                              ∀ R' ∈ Artigo.RepCat H D S.k₀ S.m₀, S.kappa Rs ≤ S.kappa R')
Artigo.Setup.variable_correctness (S : Artigo.Setup) (hH : 2 ≤ S.H) (d k r : ℕ) (m : ℤ) (u v : ℚ) :
  Artigo.IsDesc S.k₀ S.m₀ k m r → r + d ≤ S.D → S.Cvar d k m u v = (S.Rset d k m u v).inf S.costW
Artigo.Setup.variable_global (S : Artigo.Setup) (hH : 2 ≤ S.H) :
  S.Cstar = (Artigo.RepCat S.H S.D S.k₀ S.m₀).inf S.costW ∧
    (Artigo.HK S.k₀ S.m₀ ≤ S.H → S.Cstar ≠ ⊤ ∧ ∃ R ∈ Artigo.RepCat S.H S.D S.k₀ S.m₀, S.costW R = S.Cstar) ∧
      (Artigo.HK S.k₀ S.m₀ ≤ S.H →
        ∃! R, R ∈ Artigo.RepCat S.H S.D S.k₀ S.m₀ ∧ ∀ R' ∈ Artigo.RepCat S.H S.D S.k₀ S.m₀, S.kappa R ≤ S.kappa R')

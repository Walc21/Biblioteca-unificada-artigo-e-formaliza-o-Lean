Montagens.rank_bijective (i : Montagens.Phase) : Function.Bijective (Montagens.rank i)
Montagens.separated_inter {u v p q : ℝ} (huv : u < v) (hpq : p < q) (h : Set.Ioo u v ∩ Set.Ioo p q = ∅)
  (hne : (Set.Icc u v ∩ Set.Icc p q).Nonempty) :

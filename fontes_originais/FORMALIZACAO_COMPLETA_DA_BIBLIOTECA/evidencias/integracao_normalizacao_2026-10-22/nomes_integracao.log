  ∃ g, Fase3.IsAssembly α β g ∧ (Fase3.supNormOn (Set.Icc α β) fun x => f x - g x) < ε
Fase3.boundSecondDerivative_correct (E : Fase3.Expr) (J : Fase3.Iv) (P d : ℕ) (I : Fase3.Iv)
  (h : Fase3.boundSecondDerivative E J P d = some I) (x : ℝ) (hx : J.Mem x) :
  ContDiffAt ℝ 2 E.eval x ∧ deriv (deriv E.eval) x ∈ Set.Icc ↑I.lo ↑I.hi ∧ |deriv (deriv E.eval) x| ≤ ↑(Fase3.Mint I)
Fase3.calibration {M : ℕ × ℤ → ℝ} {J0 : ℕ × ℤ} {κ : ℝ} (f : ℝ → ℝ) (hκ : κ ≠ 0)
  (hM : ∀ (J : ℕ × ℤ), Fase3.cC J ⊆ Fase3.cC J0 → M J = |κ|)
  (hf2 : ∀ x ∈ Set.Icc (Fase3.cL J0) (Fase3.cR J0), Fase3.d2 f (Fase3.cL J0) (Fase3.cR J0) x = κ) :
  (∀ ε > 0,
      (∀ (s : ℕ),
          Fase3.refineAll M ε [J0] (Fase3.rcal (Fase3.mesh J0.1 ^ 2 * |κ| / 8) ε + s) =
            Fase3.refineAll M ε [J0] (Fase3.rcal (Fase3.mesh J0.1 ^ 2 * |κ| / 8) ε)) ∧
        (Fase3.refineAll M ε [J0] (Fase3.rcal (Fase3.mesh J0.1 ^ 2 * |κ| / 8) ε)).length =
          2 ^ Fase3.rcal (Fase3.mesh J0.1 ^ 2 * |κ| / 8) ε) ∧
    Filter.liminf (fun ε => √ε * ↑(Fase3.refineAll M ε [J0] (Fase3.rcal (Fase3.mesh J0.1 ^ 2 * |κ| / 8) ε)).length)
          (nhdsWithin 0 (Set.Ioi 0)) =
        1 / √8 * ∫ (x : ℝ) in Fase3.cL J0..Fase3.cR J0, √|Fase3.d2 f (Fase3.cL J0) (Fase3.cR J0) x| ∧
      Filter.limsup (fun ε => √ε * ↑(Fase3.refineAll M ε [J0] (Fase3.rcal (Fase3.mesh J0.1 ^ 2 * |κ| / 8) ε)).length)
          (nhdsWithin 0 (Set.Ioi 0)) =
        1 / √2 * ∫ (x : ℝ) in Fase3.cL J0..Fase3.cR J0, √|Fase3.d2 f (Fase3.cL J0) (Fase3.cR J0) x|

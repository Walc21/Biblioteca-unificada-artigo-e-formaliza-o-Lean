Dyadic.Lib.catalog_finite_canonical (k0 : ℕ) (m0 : ℤ) (D H : ℕ) (hH : Dyadic.Lib.HK k0 m0 ≤ H) :
  (Dyadic.Lib.RR k0 m0 D H).Finite ∧
    (Dyadic.Lib.Cat k0 m0 D H).Finite ∧
      1 ≤ (Dyadic.Lib.Cat k0 m0 D H).ncard ∧
        (Dyadic.Lib.Cat k0 m0 D H).ncard ≤ (Dyadic.Lib.RR k0 m0 D H).ncard ∧
          (Dyadic.Lib.RR k0 m0 D H).ncard ≤ Dyadic.Lib.Tshape D * (Dyadic.Lib.atomsUpTo H).card ^ 2 ^ D ∧
            (∀ (J : (ℝ → ℝ) → ℝ), ∃ g, Dyadic.Lib.IsCatMin k0 m0 D H J g) ∧
              ∀ (J : (ℝ → ℝ) → ℝ), ∃! t, Dyadic.Lib.IsCanonical k0 m0 D H J t
Dyadic.Lib.catalog_truncation (k0 : ℕ) (m0 : ℤ) :
  (∀ (D D' H H' : ℕ), D ≤ D' → H ≤ H' → Dyadic.Lib.Cat k0 m0 D H ⊆ Dyadic.Lib.Cat k0 m0 D' H') ∧
    (∀ (J : (ℝ → ℝ) → ℝ) (D D' H H' : ℕ) (g g' : ℝ → ℝ),
        D ≤ D' → H ≤ H' → Dyadic.Lib.IsCatMin k0 m0 D H J g → Dyadic.Lib.IsCatMin k0 m0 D' H' J g' → J g' ≤ J g) ∧
      ∀ (J : (ℝ → ℝ) → ℝ),
        (∃ g ∈ ⋃ D, ⋃ H, Dyadic.Lib.Cat k0 m0 D H, ∀ g' ∈ ⋃ D, ⋃ H, Dyadic.Lib.Cat k0 m0 D H, J g ≤ J g') →
          ∃ tstar D₀ H₀,
            tstar ∈ Dyadic.Lib.RR k0 m0 D₀ H₀ ∧
              (∀ g' ∈ ⋃ D, ⋃ H, Dyadic.Lib.Cat k0 m0 D H, J (Dyadic.Lib.evalRep tstar) ≤ J g') ∧
                (∀ (t : Dyadic.Lib.LTree) (D H : ℕ),
                    t ∈ Dyadic.Lib.RR k0 m0 D H →
                      (∀ g' ∈ ⋃ D, ⋃ H, Dyadic.Lib.Cat k0 m0 D H, J (Dyadic.Lib.evalRep t) ≤ J g') →
                        Dyadic.Lib.shortlex (Dyadic.Lib.serRep tstar) ≤ Dyadic.Lib.shortlex (Dyadic.Lib.serRep t)) ∧
                  ∀ (D H : ℕ), D₀ ≤ D → H₀ ≤ H → Dyadic.Lib.IsCanonical k0 m0 D H J tstar

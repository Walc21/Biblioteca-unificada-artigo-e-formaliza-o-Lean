Montagens.geometry (c : Montagens.Cell) :
  Montagens.RQ c - Montagens.LQ c = (2 ^ c.1)⁻¹ ∧
    0 < Montagens.RQ c - Montagens.LQ c ∧
      Montagens.XQ c = (Montagens.LQ c + Montagens.RQ c) / 2 ∧
        IsClosed (Montagens.J c) ∧
          Montagens.L c < Montagens.R c ∧
            (Montagens.O c).Nonempty ∧
              Montagens.L c < Montagens.X c ∧
                Montagens.X c < Montagens.R c ∧
                  Montagens.L c ∈ Montagens.Dy ∧
                    Montagens.R c ∈ Montagens.Dy ∧
                      Montagens.X c ∈ Montagens.Dy ∧ ∀ (d : Montagens.Cell), Montagens.J c = Montagens.J d → c = d
Montagens.heights_eq {α β : ℝ} (hK : α < β) (f : Montagens.CK α β) (N : ℕ) (ε : ℝ) :
  {H | 2 ≤ H ∧ Montagens.Eloc N H f ≤ ENNReal.ofReal ε} = {H | 2 ≤ H ∧ Montagens.Econ N H f ≤ ENNReal.ofReal ε} ∧
    sInf {H | 2 ≤ H ∧ Montagens.Eloc N H f ≤ ENNReal.ofReal ε} =
      sInf {H | 2 ≤ H ∧ Montagens.Econ N H f ≤ ENNReal.ofReal ε}

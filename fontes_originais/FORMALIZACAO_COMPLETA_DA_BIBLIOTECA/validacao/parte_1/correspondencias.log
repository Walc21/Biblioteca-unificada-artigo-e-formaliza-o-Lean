Montagens.bridge {α β : ℝ} (hK : α < β) :
  (Montagens.B2 α β = Montagens.Aloc α β ∧ Montagens.Aloc α β = Montagens.Astr α β) ∧
    Montagens.ResImage α β (Montagens.B3 α β) = Montagens.Aloc α β ∧
      Montagens.ResImage α β (Montagens.Bcon α β) = Montagens.Astr α β ∧ Montagens.B3 α β = Montagens.Bcon α β
Montagens.cellsToAtoms_spec {α β : ℝ} (i : Montagens.Phase) {g : Montagens.CK α β} {F : Finset Montagens.Cell}
  {e : Montagens.Cell → ℕ} (h : Montagens.CellRep i α β g F e) :
  Montagens.LocalRep α β g (Montagens.cellsToAtoms i F e) ∧
    (Montagens.cellsToAtoms i F e).card = F.card ∧
      Montagens.atomsToCells (Montagens.cellsToAtoms i F e) = F ∧
        ∀ c ∈ F, Montagens.addrOf i (Montagens.cellsToAtoms i F e) c = e c
Montagens.cellsToAtoms_specG {α β : ℝ} (i : Montagens.Phase) {G : ℝ → ℝ} {F : Finset Montagens.Cell}
  {e : Montagens.Cell → ℕ} (h : Montagens.CellRepG i α β G F e) :
  Montagens.LocalRepG α β G (Montagens.cellsToAtoms i F e) ∧
    (Montagens.cellsToAtoms i F e).card = F.card ∧
      Montagens.atomsToCells (Montagens.cellsToAtoms i F e) = F ∧
        ∀ c ∈ F, Montagens.addrOf i (Montagens.cellsToAtoms i F e) c = e c

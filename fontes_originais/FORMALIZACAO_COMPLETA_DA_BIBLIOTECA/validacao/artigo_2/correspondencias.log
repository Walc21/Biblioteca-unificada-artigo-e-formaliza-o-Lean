Artigo.cantorPair_le (u v : ℕ) : Artigo.cantorPair u v ≤ (u + v + 1) ^ 2
Artigo.card_LH_ge : ∃ c, 0 < c ∧ ∃ H₁, 2 ≤ H₁ ∧ ∀ H ≥ H₁, c * ↑H ^ 6 ≤ ↑(Artigo.LH H).card
Artigo.card_LH_le {H : ℕ} (hH : 2 ≤ H) : (Artigo.LH H).card ≤ 18 * H ^ 6
Artigo.card_LH_theta :
  ∃ c C, 0 < c ∧ 0 < C ∧ ∀ (H : ℕ), 2 ≤ H → c * ↑H ^ 6 ≤ ↑(Artigo.LH H).card ∧ ↑(Artigo.LH H).card ≤ C * ↑H ^ 6

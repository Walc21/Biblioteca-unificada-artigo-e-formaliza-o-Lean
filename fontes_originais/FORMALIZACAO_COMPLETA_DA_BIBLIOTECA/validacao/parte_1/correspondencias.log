  (h₂ : c + s * x₂ = c' + s' * x₂) (x : ℝ) : c + s * x = c' + s' * x
Montagens.atomsToCells_spec {α β : ℝ} (i : Montagens.Phase) {g : Montagens.CK α β} {Λ : Finset Montagens.Atom}
  (h : Montagens.LocalRep α β g Λ) :
  Montagens.CellRep i α β g (Montagens.atomsToCells Λ) (Montagens.addrOf i Λ) ∧
    (Montagens.atomsToCells Λ).card = Λ.card ∧
      Montagens.cellsToAtoms i (Montagens.atomsToCells Λ) (Montagens.addrOf i Λ) = Λ
Montagens.atomsToCells_specG {α β : ℝ} (i : Montagens.Phase) {G : ℝ → ℝ} {Λ : Finset Montagens.Atom}
  (h : Montagens.LocalRepG α β G Λ) :
  Montagens.CellRepG i α β G (Montagens.atomsToCells Λ) (Montagens.addrOf i Λ) ∧
    (Montagens.atomsToCells Λ).card = Λ.card ∧

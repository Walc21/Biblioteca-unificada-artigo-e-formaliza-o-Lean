Artigo.Zenum_bijective : Function.Bijective Artigo.Zenum
Artigo.Zinv_le (m : ℤ) : ↑(Artigo.Zinv m) ≤ 2 * |m| + 1
Artigo.address_lower :
  ∃ c,
    0 < c ∧
      ∃ C H₁,
        2 ≤ H₁ ∧
          ∀ (A : Artigo.Atom → ℕ),
            Function.Injective A →
              ∀ H ≥ H₁, ∃ a, a.height ≤ H ∧ c * ↑H ^ 6 - 1 ≤ ↑(A a) ∧ 6 * Real.logb 2 ↑H - C ≤ Real.logb 2 (↑(A a) + 1)
Artigo.assemblies_dense {k₀ : ℕ} {m₀ : ℤ} {f : ℝ → ℝ} (hf : ContinuousOn f (Artigo.cellIcc k₀ m₀)) {ε : ℝ}
  (hε : 0 < ε) : ∃ T, Artigo.LTree.WF k₀ m₀ T ∧ ∀ x ∈ Artigo.cellIcc k₀ m₀, |f x - Artigo.LTree.eval k₀ m₀ T x| < ε
Artigo.assembly_height_arith {k : ℕ} {m : ℤ} {T : Artigo.LTree} (hT : Artigo.LTree.WF k m T) {H : ℕ}
  (hH : T.maxHeight ≤ H) :
  (∀ p ∈ T.leaves.zip T.leaves.tail,
      Artigo.ht (p.2.s - p.1.s) ≤ 2 * H ^ 2 ∧
        p.2.left.num.natAbs ≤ H ∧ (∃ j ≤ H, p.2.left.den = 2 ^ j) ∧ Artigo.ht (p.2.s * p.2.left) ≤ H * 2 ^ H) ∧
    Artigo.ht (T.lval - T.firstLeaf.s * T.firstLeaf.left) ≤ 2 ^ (H + 1) * H ^ 2
Artigo.assembly_serialization (k : ℕ) (m : ℤ) :
  ∃ ser dec,
    (∀ (T : Artigo.LTree), Artigo.LTree.WF k m T → ∀ (t : List Bool), dec (ser T ++ t) = some (T, t)) ∧
      (∀ (T : Artigo.LTree),
          Artigo.LTree.WF k m T →
            (ser T).length ≤
              2 * Nat.log 2 T.numLeaves + 1 + (2 * Nat.log 2 T.maxHeight + 1) +
                T.numLeaves * Nat.clog 2 (18 * T.maxHeight ^ 6)) ∧
        ∀ (T : Artigo.LTree),
          Artigo.LTree.WF k m T →
            (ser T).length ≤
              2 * Nat.log 2 T.numLeaves + 1 + (2 * Nat.log 2 T.maxHeight + 1) +
                T.numLeaves * (6 * Nat.log 2 T.maxHeight + 11)
Artigo.assembly_serialization_Gamma (k : ℕ) (m : ℤ) :
  ∃ ser dec,
    (∀ (T : Artigo.LTree), Artigo.LTree.WF k m T → ∀ (t : List Bool), dec (ser T ++ t) = some (T, t)) ∧
      ∀ (T : Artigo.LTree),
        Artigo.LTree.WF k m T →
          (ser T).length ≤
            2 * Nat.log 2 T.numLeaves + 1 + (2 * Nat.log 2 T.maxHeight + 1) +
              T.numLeaves * (8 * Nat.log 2 T.maxHeight + 20)

Montagens.ht_props (r : ℚ) : 1 ≤ Montagens.ht r ∧ r.num.natAbs ≤ Montagens.ht r ∧ r.den ≤ Montagens.ht r
Montagens.line_forms (a : Montagens.Atom) :
  (∀ (x : ℝ), a.line x = ↑a.u + ↑a.b * x) ∧ a.line a.Xa = ↑a.y ∧ Continuous a.line ∧ ↑a.b ≠ 0
Montagens.norm_fixed_of_active {α β : ℝ} {Λ : Finset Montagens.Atom} (h : ∀ a ∈ Λ, Montagens.Active α β a) :
  Montagens.NormK α β Λ = Λ

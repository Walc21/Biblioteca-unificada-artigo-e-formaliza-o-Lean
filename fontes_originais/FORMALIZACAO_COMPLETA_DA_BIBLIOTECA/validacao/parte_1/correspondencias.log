  Montagens.NormK α β Λ = Λ
Montagens.normalization {α β : ℝ} (hK : α < β) {g : Montagens.CK α β} {Λ : Finset Montagens.Atom}
  (h : Montagens.LocalRep α β g Λ) :
  (Montagens.NormK α β Λ ⊆ Λ ∧ (Montagens.NormK α β Λ).card ≤ Λ.card) ∧
    (Montagens.Cover (Montagens.K α β) (Montagens.NormK α β Λ) ∧ (Montagens.NormK α β Λ).Nonempty) ∧
      (∀ a ∈ Montagens.NormK α β Λ, ∀ b ∈ Montagens.NormK α β Λ, a ≠ b → a.Ja ∩ b.Ja ⊆ Montagens.Kint α β) ∧
        Montagens.StrongRep α β g (Montagens.NormK α β Λ) ∧
          Montagens.NormK α β (Montagens.NormK α β Λ) = Montagens.NormK α β Λ
Montagens.normalizationG {α β : ℝ} (hK : α < β) {G : ℝ → ℝ} {Λ : Finset Montagens.Atom}
  (h : Montagens.LocalRepG α β G Λ) :
  (Montagens.NormK α β Λ ⊆ Λ ∧ (Montagens.NormK α β Λ).card ≤ Λ.card) ∧
    (Montagens.Cover (Montagens.K α β) (Montagens.NormK α β Λ) ∧ (Montagens.NormK α β Λ).Nonempty) ∧
      (∀ a ∈ Montagens.NormK α β Λ, ∀ b ∈ Montagens.NormK α β Λ, a ≠ b → a.Ja ∩ b.Ja ⊆ Montagens.Kint α β) ∧
        Montagens.StrongRepG α β G (Montagens.NormK α β Λ) ∧
          Montagens.NormK α β (Montagens.NormK α β Λ) = Montagens.NormK α β Λ
Montagens.pack (x : ℕ × ℕ × ℕ × ℕ) : ℕ
Montagens.pair (u v : ℕ) : ℕ
Montagens.pair_props :
  (∀ (n : ℕ),
      Montagens.T (Montagens.wdiag n) ≤ n ∧
        n < Montagens.T (Montagens.wdiag n + 1) ∧ Montagens.vdiag n ≤ Montagens.wdiag n) ∧
    (∀ (u v : ℕ), Montagens.unpair (Montagens.pair u v) = (u, v)) ∧
      (∀ (n : ℕ), Montagens.pair (Montagens.unpair n).1 (Montagens.unpair n).2 = n) ∧
        (∀ (x : ℕ × ℕ × ℕ × ℕ), Montagens.unpack (Montagens.pack x) = x) ∧
          (∀ (n : ℕ), Montagens.pack (Montagens.unpack n) = n) ∧
            ∀ (n : ℕ), Montagens.wdiag n = ((8 * n + 1).sqrt - 1) / 2

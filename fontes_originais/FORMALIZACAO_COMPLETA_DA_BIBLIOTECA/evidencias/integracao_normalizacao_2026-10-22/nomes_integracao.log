  SemanticBridge.normalizationAtomEquiv (SemanticBridge.ofFase2 n) = Montagens.dec Montagens.Phase.two n
SemanticBridge.normalization_ofFase3 (n : ℕ) :
  SemanticBridge.normalizationAtomEquiv (SemanticBridge.ofFase3 n) = Montagens.dec Montagens.Phase.three n
SemanticBridge.normalization_pair (u v : ℕ) : Montagens.pair u v = Fase3.cpair u v
SemanticBridge.normalization_rank2 (r : ℚ) : Montagens.rank Montagens.Phase.two r = Dyadic2.Qrank r
SemanticBridge.normalization_rank3 (r : ℚ) : Montagens.rank Montagens.Phase.three r = Fase3.rankQ r
SemanticBridge.normalization_strong_iff (α β : ℝ) (g : ℝ → ℝ) (Λ : Finset Dyadic.Lib.Atom) :
  Montagens.StrongRepG α β g (SemanticBridge.normalizationAtoms Λ) ↔ Dyadic.Lib.IsAssemblyRep (Set.Icc α β) g Λ
SemanticBridge.normalization_typed_budget_iff {α β : ℝ} (g : Montagens.CK α β) (G : ℝ → ℝ)
  (hG : ContinuousOn G (Set.Icc α β)) (hgg : ∀ (z : ↑(Set.Icc α β)), g z = G ↑z) (N H : ℕ) :
  g ∈ Montagens.AstrNH α β N H ↔ G ∈ Dyadic.Lib.AsmNH (Set.Icc α β) N H
SemanticBridge.normalization_unpack2 (n : ℕ) : Montagens.unpack n = Dyadic2.unpack n
SemanticBridge.normalization_unpack3 (n : ℕ) : Montagens.unpack n = Fase3.decode4 n
SemanticBridge.normalizeAtoms_card_le (α β : ℝ) (Λ : Finset Dyadic.Lib.Atom) :
  (SemanticBridge.normalizeAtoms α β Λ).card ≤ Λ.card
SemanticBridge.normalizeAtoms_idem (α β : ℝ) (Λ : Finset Dyadic.Lib.Atom) :
  SemanticBridge.normalizeAtoms α β (SemanticBridge.normalizeAtoms α β Λ) = SemanticBridge.normalizeAtoms α β Λ
SemanticBridge.normalizeAtoms_strong {α β : ℝ} (hK : α < β) {g : ℝ → ℝ} {Λ : Finset Dyadic.Lib.Atom}
  (h : SemanticBridge.AssemblyCore (Set.Icc α β) g Λ) :
  Dyadic.Lib.IsAssemblyRep (Set.Icc α β) g (SemanticBridge.normalizeAtoms α β Λ)
SemanticBridge.normalizeAtoms_subset (α β : ℝ) (Λ : Finset Dyadic.Lib.Atom) : SemanticBridge.normalizeAtoms α β Λ ⊆ Λ

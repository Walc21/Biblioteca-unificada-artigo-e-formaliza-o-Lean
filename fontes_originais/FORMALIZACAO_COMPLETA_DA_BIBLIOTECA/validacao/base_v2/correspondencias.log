Dyadic.Lib.entropy_codebook {R M : ℝ} (hR : 0 < R) (hM : 0 < M) :
  ∃ ε₀ > 0,
    ∃ c > 0,
      ∃ C > 0,
        ∃ C₁ > 0,
          ∀ (ε : ℝ),
            0 < ε →
              ε < ε₀ →
                c / √ε ≤ Dyadic.Lib.metricEntropy (Dyadic.Lib.FRMC R M) ε ∧
                  Dyadic.Lib.metricEntropy (Dyadic.Lib.FRMC R M) ε ≤ C / √ε ∧
                    ∃ CB,
                      ↑CB ⊆ Dyadic.Lib.Asm (Set.Icc 0 1) ∧
                        (∀ f ∈ Dyadic.Lib.FRM R M, ∃ g ∈ CB, ∀ x ∈ Set.Icc 0 1, |f x - g x| ≤ ε) ∧
                          ↑⌈Real.logb 2 ↑CB.card⌉₊ ≤ C₁ / √ε ∧
                            Dyadic.Lib.metricEntropy (Dyadic.Lib.FRMC R M) ε ≤ Real.logb 2 ↑CB.card
Dyadic.Lib.formats_comparison :
  (∀ (a : ℕ → Dyadic.Lib.Atom) (N : ℕ),
      1 ≤ N →
        ∀ (r : List Bool),
          Dyadic.Lib.decStreamAtom (Dyadic.Lib.streamAtom a N ++ r) = some (List.map a (List.range N), r) ∧
            Dyadic.Lib.decStreamStr (Dyadic.Lib.streamStr a N ++ r) =
                some (((a 0).center, (a 0).y0, (a 0).s, Dyadic.Lib.jumps a N), r) ∧
              Dyadic.Lib.decStreamRat (Dyadic.Lib.streamRat a N ++ r) =
                some (((a 0).intercept, (a 0).s, Dyadic.Lib.jumps a N), r)) ∧
    (∀ (a b : ℕ → Dyadic.Lib.Atom) (N M : ℕ),
        1 ≤ N →
          1 ≤ M →
            (Dyadic.Lib.streamAtom a N <+: Dyadic.Lib.streamAtom b M →
                Dyadic.Lib.streamAtom a N = Dyadic.Lib.streamAtom b M) ∧
              (Dyadic.Lib.streamStr a N <+: Dyadic.Lib.streamStr b M →
                  Dyadic.Lib.streamStr a N = Dyadic.Lib.streamStr b M) ∧
                (Dyadic.Lib.streamRat a N <+: Dyadic.Lib.streamRat b M →
                  Dyadic.Lib.streamRat a N = Dyadic.Lib.streamRat b M)) ∧
      (∀ (K : Set ℝ) (g : ℝ → ℝ) (a : ℕ → Dyadic.Lib.Atom) (N : ℕ),
          1 ≤ N →
            (∀ (j : ℕ), j + 1 < N → (a j).right = (a (j + 1)).left) →
              (∀ (j : ℕ), j + 1 < N → (a j).line ↑(a j).right = (a (j + 1)).line ↑(a (j + 1)).left) →
                (∀ j < N, ∀ x ∈ (a j).cell ∩ K, g x = (a j).line x) →
                  K ⊆ Set.Icc ↑(a 0).left ↑(a (N - 1)).right →
                    (a 0).intercept = (a 0).y0 - (a 0).s * (a 0).center ∧
                      ∀ x ∈ K, g x = Dyadic.Lib.reluEval (a 0).intercept (a 0).s (Dyadic.Lib.jumps a N) x) ∧
        ∃ C,
          ∀ (a : ℕ → Dyadic.Lib.Atom) (N H : ℕ),
            1 ≤ N →
              2 ≤ H →
                (∀ j < N, (a j).height ≤ H) →
                  ↑(Dyadic.Lib.streamAtom a N).length ≤ C * ↑N * Real.logb 2 ↑H ∧
                    ↑(Dyadic.Lib.streamStr a N).length ≤ C * ↑N * Real.logb 2 ↑H ∧
                      ↑(Dyadic.Lib.streamRat a N).length ≤ C * ↑N * ↑H
Dyadic.Lib.formats_family {H N : ℕ} (hH : 2 ≤ H) (hNe : Even N) (hN2 : 2 ≤ N) (hNH : N ≤ H) :
  (∀ (j : ℕ), j + 1 < N → (Dyadic.Lib.famAtom H j).right = (Dyadic.Lib.famAtom H (j + 1)).left) ∧
    (∀ (j : ℕ),
        j + 1 < N →
          (Dyadic.Lib.famAtom H j).line ↑(Dyadic.Lib.famAtom H j).right =
            (Dyadic.Lib.famAtom H (j + 1)).line ↑(Dyadic.Lib.famAtom H (j + 1)).left) ∧
      Dyadic.Lib.chainFun (Dyadic.Lib.famAtom H) N ∈
          Dyadic.Lib.Asm (Set.Icc ↑(Dyadic.Lib.famAtom H 0).left ↑(Dyadic.Lib.famAtom H (N - 1)).right) ∧
        Dyadic.Lib.IsAssemblyRep (Set.Icc ↑(Dyadic.Lib.famAtom H 0).left ↑(Dyadic.Lib.famAtom H (N - 1)).right)
            (Dyadic.Lib.chainFun (Dyadic.Lib.famAtom H) N) (Finset.image (Dyadic.Lib.famAtom H) (Finset.range N)) ∧
          (Finset.image (Dyadic.Lib.famAtom H) (Finset.range N)).card = N ∧
            Dyadic.Lib.maxHeight (Finset.image (Dyadic.Lib.famAtom H) (Finset.range N)) = H ∧
              ↑(Dyadic.Lib.streamAtom (Dyadic.Lib.famAtom H) N).length ≤ 200 * ↑N * Real.logb 2 ↑H ∧
                ↑(Dyadic.Lib.streamStr (Dyadic.Lib.famAtom H) N).length ≤ 200 * ↑N * Real.logb 2 ↑H ∧
                  ↑N * ↑H / 2 ≤ ↑(Dyadic.Lib.streamRat (Dyadic.Lib.famAtom H) N).length
Dyadic.Lib.height_calculus {H : ℕ} (a b : Dyadic.Lib.Atom) (ha : a.height ≤ H) (hb : b.height ≤ H) :
  (∀ t ∈ {a.left, a.right}, t.num.natAbs ≤ H ∧ ∃ k' ≤ H, t.den = 2 ^ k') ∧
    Dyadic.Lib.ratHeight (b.s - a.s) ≤ 2 * H ^ 2 ∧
      Dyadic.Lib.ratHeight (b.s * b.left) ≤ H * 2 ^ H ∧ Dyadic.Lib.ratHeight a.intercept ≤ 2 ^ (H + 1) * H ^ 2

Fase3.refine_correct {f : ℝ → ℝ} {α β : ℝ} (hαβ : α < β) (hf : ContDiffOn ℝ 2 f (Set.Icc α β)) (M : ℕ × ℤ → ℝ)
  {Mstar εI εR h0 : ℝ}
  (hM : ∀ (J : ℕ × ℤ), (∀ x ∈ Fase3.cC J, |deriv (deriv (Fase3.extF f α β)) x| ≤ M J) ∧ M J ≤ Mstar) (hεI : 0 < εI)
  (hεR : 0 < εR) (roots : List (ℕ × ℤ)) (hroots : List.Pairwise Fase3.DisjInt roots)
  (hcov : Set.Icc α β ⊆ ⋃ J ∈ roots, Fase3.cC J) (hh0 : ∀ J ∈ roots, Fase3.mesh J.1 ≤ h0) :
  (∃ v,
      (∀ J ∈ Fase3.refineAll M εI roots (Fase3.rStar h0 Mstar εI),
          |↑(v (Fase3.cL J)) - Fase3.extF f α β (Fase3.cL J)| < εR ∧
            |↑(v (Fase3.cR J)) - Fase3.extF f α β (Fase3.cR J)| < εR) ∧
        ∀ J ∈ Fase3.refineAll M εI roots (Fase3.rStar h0 Mstar εI), v (Fase3.cL J) ≠ v (Fase3.cR J)) ∧
    ∀ (v : ℝ → ℚ),
      (∀ J ∈ Fase3.refineAll M εI roots (Fase3.rStar h0 Mstar εI),
          |↑(v (Fase3.cL J)) - Fase3.extF f α β (Fase3.cL J)| < εR ∧
            |↑(v (Fase3.cR J)) - Fase3.extF f α β (Fase3.cR J)| < εR) →
        (∀ J ∈ Fase3.refineAll M εI roots (Fase3.rStar h0 Mstar εI), v (Fase3.cL J) ≠ v (Fase3.cR J)) →
          Fase3.IsAssembly α β
              (Fase3.cellInterp (Fase3.refineAll M εI roots (Fase3.rStar h0 Mstar εI)).toFinset fun t => ↑(v t)) ∧
            (∀ J ∈ Fase3.refineAll M εI roots (Fase3.rStar h0 Mstar εI),
                ∃! n,
                  Fase3.gK n = J.1 ∧
                    Fase3.gM n = J.2 ∧ ∀ (x : ℝ), Fase3.atomLine n x = Fase3.lin J (fun t => ↑(v t)) x) ∧
              (Fase3.supNormOn (Set.Icc α β) fun x =>
                  f x -
                    Fase3.cellInterp (Fase3.refineAll M εI roots (Fase3.rStar h0 Mstar εI)).toFinset (fun t => ↑(v t))
                      x) ≤
                εI + εR
Fase3.refine_terminates (M : ℕ × ℤ → ℝ) {Mstar εI h0 : ℝ} (hM : ∀ (J : ℕ × ℤ), M J ≤ Mstar) (hεI : 0 < εI)
  (roots : List (ℕ × ℤ)) (hh0 : ∀ J ∈ roots, Fase3.mesh J.1 ≤ h0) :
  (∀ (s : ℕ),
      Fase3.refineAll M εI roots (Fase3.rStar h0 Mstar εI + s) = Fase3.refineAll M εI roots (Fase3.rStar h0 Mstar εI)) ∧
    (∀ L ∈ Fase3.refineAll M εI roots (Fase3.rStar h0 Mstar εI), Fase3.cert M L ≤ εI) ∧
      (∀ L ∈ Fase3.refineAll M εI roots (Fase3.rStar h0 Mstar εI),
          ∃ J0 ∈ roots, J0.1 ≤ L.1 ∧ L.1 ≤ J0.1 + Fase3.rStar h0 Mstar εI ∧ Fase3.cC L ⊆ Fase3.cC J0) ∧
        (Fase3.refineAll M εI roots (Fase3.rStar h0 Mstar εI)).length ≤ roots.length * 2 ^ Fase3.rStar h0 Mstar εI
